---
// Shared formula/cask detail body (ports detail-template.html). All content is
// server-rendered; the client script only adds progressive enhancement.
import StabilityBadge from "./StabilityBadge.astro";
import VersionHistory from "./VersionHistory.astro";
import { safeUrl } from "../lib/serialize.mjs";

const {
  name,
  version,
  desc,
  homepage,
  caveats,
  stability,
  versions,
  installCommand,
  parent,
  parentAnchor,
  extraRow,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const caveatsHidden = caveats ? "" : "hidden";
const versionsHidden = versions.length ? "" : "hidden";
const homepageHref = safeUrl(homepage);
---
<!-- Breadcrumb -->
<div class="border-b border-[var(--card-border)] bg-[var(--bg-alt)] transition-all duration-200 ease-in-out">
  <div class="max-w-[1080px] mx-auto px-6 py-3 text-[0.85rem] flex items-center gap-1.5">
    <a href={`${base}/`} class="text-[var(--text-muted)] hover:text-[var(--link)]">Home</a>
    <span class="text-[var(--text-muted)]">/</span>
    <a href={`${base}/#${parentAnchor}-section`} class="text-[var(--text-muted)] hover:text-[var(--link)]">{parent}</a>
    <span class="text-[var(--text-muted)]">/</span>
    <span class="text-[var(--text)] font-semibold" id="breadcrumb-name">{name}</span>
  </div>
</div>

<!-- Detail -->
<div class="max-w-[1080px] mx-auto px-6 max-sm:px-4">
  <!-- Mobile: horizontal scrollable strip -->
  <nav class="sticky top-[60px] z-50 -mx-6 max-sm:-mx-4 px-6 max-sm:px-4 py-2 bg-[var(--bg)] border-b border-[var(--card-border)]
              overflow-x-auto whitespace-nowrap flex gap-2 [scrollbar-width:none] md:hidden"
       id="sidebar-mobile" aria-label="Page sections">
    <a href="#install-section" class="sidebar-link text-[0.8rem] font-semibold px-3 py-1.5 rounded-md
       text-[var(--text-muted)] hover:text-[var(--link)] transition-colors shrink-0" data-section="install-section">Install</a>
    <a href="#details-section" class="sidebar-link text-[0.8rem] font-semibold px-3 py-1.5 rounded-md
       text-[var(--text-muted)] hover:text-[var(--link)] transition-colors shrink-0" data-section="details-section">Details</a>
    <a href="#caveats-section" class:list={["sidebar-link text-[0.8rem] font-semibold px-3 py-1.5 rounded-md text-[var(--text-muted)] hover:text-[var(--link)] transition-colors shrink-0", caveatsHidden]} data-section="caveats-section">Caveats</a>
    <a href="#versions-section" class:list={["sidebar-link text-[0.8rem] font-semibold px-3 py-1.5 rounded-md text-[var(--text-muted)] hover:text-[var(--link)] transition-colors shrink-0", versionsHidden]} data-section="versions-section">Versions</a>
  </nav>

  <div class="flex gap-8 pt-12 pb-16 max-md:block max-md:py-10">
    <!-- Desktop: sticky sidebar -->
    <aside class="w-[180px] shrink-0 max-md:hidden">
      <nav class="sticky top-[80px]" aria-label="Page sections">
        <ul class="list-none p-0 m-0 space-y-1">
          <li><a href="#install-section" class="sidebar-link block text-[0.85rem] font-medium py-1.5 px-3
              rounded-md text-[var(--text-muted)] hover:text-[var(--link)] hover:bg-accent-subtle
              transition-all border-l-2 border-transparent" data-section="install-section">Install</a></li>
          <li><a href="#details-section" class="sidebar-link block text-[0.85rem] font-medium py-1.5 px-3
              rounded-md text-[var(--text-muted)] hover:text-[var(--link)] hover:bg-accent-subtle
              transition-all border-l-2 border-transparent" data-section="details-section">Details</a></li>
          <li class={caveatsHidden}><a href="#caveats-section" class="sidebar-link block text-[0.85rem] font-medium py-1.5 px-3
              rounded-md text-[var(--text-muted)] hover:text-[var(--link)] hover:bg-accent-subtle
              transition-all border-l-2 border-transparent" data-section="caveats-section">Caveats</a></li>
          <li class={versionsHidden}><a href="#versions-section" class="sidebar-link block text-[0.85rem] font-medium py-1.5 px-3
              rounded-md text-[var(--text-muted)] hover:text-[var(--link)] hover:bg-accent-subtle
              transition-all border-l-2 border-transparent" data-section="versions-section">Versions</a></li>
        </ul>
      </nav>
    </aside>

    <!-- Main content -->
    <main id="main" class="flex-1 min-w-0">
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <h1 class="text-[2rem] font-extrabold tracking-tight max-sm:text-[1.5rem]" id="detail-name">{name}</h1>
          <span class="font-mono text-[0.85rem] bg-accent-subtle text-[var(--link)] px-2 py-0.5 rounded-xl whitespace-nowrap">v{version}</span>
          <StabilityBadge stability={stability} />
        </div>
        <p class="text-[var(--text-muted)] text-[1.1rem]" id="detail-desc">{desc}</p>
      </div>

      <!-- Install Command -->
      <div class="bg-[var(--card-bg)] border border-[var(--card-border)] rounded-md p-6 mb-5 transition-all duration-200 ease-in-out scroll-mt-24" id="install-section">
        <h2 class="text-[0.8rem] font-semibold mb-4 uppercase tracking-widest text-[var(--text-muted)]">Install</h2>
        <div class="inline-flex items-center gap-3 bg-[var(--code-bg)] border border-[var(--code-border)] rounded-md px-5 py-3.5 font-mono text-[0.95rem] text-[var(--text)] w-full shadow-none">
          <code id="install-command">{installCommand}</code>
          <button type="button" class="copy-btn flex items-center justify-center w-8 h-8 border-none rounded-sm bg-accent text-white cursor-pointer transition-all duration-200 ease-in-out hover:bg-accent-hover hover:scale-105 shrink-0 ml-auto" onclick="copyText('install-command', this)" aria-label="Copy install command">
            <svg aria-hidden="true" focusable="false" class="icon-copy w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <svg aria-hidden="true" focusable="false" class="icon-check w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Details -->
      <div class="bg-[var(--card-bg)] border border-[var(--card-border)] rounded-md p-6 mb-5 transition-all duration-200 ease-in-out scroll-mt-24" id="details-section">
        <h2 class="text-[0.8rem] font-semibold mb-4 uppercase tracking-widest text-[var(--text-muted)]">Details</h2>
        <dl class="grid gap-0">
          <div class="flex items-baseline py-2.5 border-b border-[var(--card-border)] first:pt-0 last:border-b-0 last:pb-0 max-sm:flex-col max-sm:gap-0.5">
            <dt class="w-[120px] shrink-0 text-[0.85rem] font-semibold text-[var(--text-muted)] max-sm:w-auto">Homepage</dt>
            <dd class="text-[0.9rem]"><a id="detail-homepage" href={homepageHref} target="_blank" rel="noopener noreferrer">{homepage}</a></dd>
          </div>
          {extraRow && (
            <div class="flex items-baseline py-2.5 border-b border-[var(--card-border)] first:pt-0 last:border-b-0 last:pb-0 max-sm:flex-col max-sm:gap-0.5">
              <dt class="w-[120px] shrink-0 text-[0.85rem] font-semibold text-[var(--text-muted)] max-sm:w-auto">{extraRow.label}</dt>
              <dd class="text-[0.9rem]">{extraRow.value}</dd>
            </div>
          )}
          <div class="flex items-baseline py-2.5 border-b border-[var(--card-border)] first:pt-0 last:border-b-0 last:pb-0 max-sm:flex-col max-sm:gap-0.5">
            <dt class="w-[120px] shrink-0 text-[0.85rem] font-semibold text-[var(--text-muted)] max-sm:w-auto">Version</dt>
            <dd class="text-[0.9rem]">v{version}</dd>
          </div>
          <div class="flex items-baseline py-2.5 border-b border-[var(--card-border)] first:pt-0 last:border-b-0 last:pb-0 max-sm:flex-col max-sm:gap-0.5">
            <dt class="w-[120px] shrink-0 text-[0.85rem] font-semibold text-[var(--text-muted)] max-sm:w-auto">Stability</dt>
            <dd class="text-[0.9rem]">
              {stability === "stable"
                ? "Stable"
                : <><StabilityBadge stability={stability} /> &mdash; not yet considered stable</>}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Caveats -->
      <div class:list={["bg-[var(--card-bg)] border border-[var(--card-border)] rounded-md p-6 mb-5 transition-all duration-200 ease-in-out scroll-mt-24", caveatsHidden]} id="caveats-section">
        <h2 class="text-[0.8rem] font-semibold mb-4 uppercase tracking-widest text-[var(--text-muted)]">Caveats</h2>
        <pre class="bg-[var(--code-bg)] border border-[var(--code-border)] rounded-sm p-4 font-mono text-[0.85rem] text-[var(--text)] whitespace-pre-wrap break-words leading-normal overflow-x-auto">{caveats}</pre>
      </div>

      <!-- Version History -->
      <div class:list={["bg-[var(--card-bg)] border border-[var(--card-border)] rounded-md p-6 mb-5 transition-all duration-200 ease-in-out scroll-mt-24", versionsHidden]} id="versions-section">
        <h2 class="text-[0.8rem] font-semibold mb-4 uppercase tracking-widest text-[var(--text-muted)]">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 6px;">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Version History
        </h2>
        <div class="table-wrap bg-[var(--card-bg)] border border-[var(--card-border)] rounded-md overflow-hidden shadow-[var(--shadow)] transition-all duration-200 ease-in-out max-sm:rounded-none max-sm:border-x-0">
          <table>
            <thead>
              <tr>
                <th>Version</th>
                <th>Date</th>
                <th>Status</th>
                <th><span class="sr-only">Release notes link</span></th>
              </tr>
            </thead>
            <VersionHistory versions={versions} current={version} />
          </table>
        </div>
      </div>
    </main>
  </div>
</div>
